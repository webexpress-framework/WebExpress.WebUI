<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<OutputType>Exe</OutputType>
		<TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
		<Configurations>Debug;Release;Test;DebugLocal</Configurations>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Data\ComplexExample1.md" />
		<None Remove="Data\ComplexExample2.md" />
		<None Remove="Data\ComplexExample3.md" />
		<None Remove="Data\ComplexForm.txt" />
		<None Remove="Data\TableExample1.md" />
		<None Remove="Data\TableExample2.md" />
		<None Remove="Data\TableExample3.md" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
		<PackageReference Include="xunit.v3" Version="3.2.2" />
	</ItemGroup>

	<!-- mirrors WebExpress.WebUI: DebugLocal builds against the WebCore sources next door,
	     so a test can exercise a WebCore change; every other configuration takes the
	     published package. Without the split the package copy wins in the test output and
	     the tests silently run against the released WebCore instead of the local one. -->
	<ItemGroup Condition="'$(Configuration)' != 'DebugLocal'">
		<PackageReference Include="WebExpress.WebCore" Version="2.0.0-alpha" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' == 'DebugLocal'">
		<ProjectReference Include="..\..\..\WebExpress.WebCore\src\WebExpress.WebCore\WebExpress.WebCore.csproj" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\WebExpress.WebUI\WebExpress.WebUI.csproj" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Assets/**/*.*">
			<LogicalName>$(MSBuildProjectName).Assets.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Data\ComplexExample1.md" />
		<EmbeddedResource Include="Data\ComplexExample2.md" />
		<EmbeddedResource Include="Data\ComplexExample3.md" />
		<EmbeddedResource Include="Data\ComplexForm.txt" />
		<EmbeddedResource Include="Data\TableExample1.md" />
		<EmbeddedResource Include="Data\TableExample2.md" />
		<EmbeddedResource Include="Data\TableExample3.md" />
	</ItemGroup>

</Project>
